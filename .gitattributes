# Mark code-generated files from butcher tool as generated
.butcher/**/*.json linguist-generated=true
# .butcher/**/*.yml linguist-generated=true

# These files are auto-generated and should be collapsed in PRs
# .butcher/ linguist-generated=true

# butcher writes and compares these byte for byte: LF on every platform, also on Windows checkouts
butcher/** text eol=lf
crates/butcher/tests/fixtures/** text eol=lf

# Pinned corpus: checked out byte-for-byte on every platform (no CRLF conversion),
# because MANIFEST.toml pins each file's sha256.
benchmarks/corpus/** -text
